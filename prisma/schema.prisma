generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id              String @id @default(uuid())
    first_name      String
    last_name       String
    email           String @unique
    phone_number    String @unique
    password        String
    profile_picture String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
